-   name: rf_bw
    id: variable
    parameters:
        comment: ''
        value: int(min(max(1.5 * 1.35 * samp_rate / sps, 1e6), samp_rate))
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 200
        - 150
        state: enabled
-   name: rrc_rx_taps
    id: variable
    parameters:
        comment: ''
        value: firdes.root_raised_cosine(1.0, samp_rate, samp_rate / sps, 0.35, 11
            * sps)
    states:
        bus_sink: false
        bus_source: false
        bus_structure: null
        coordinate:
        - 770
        - 150
        state: enabled
-   name: rrc_tx_taps
    id: variable
    parameters:
        comment: ''
        value: firdes.root_raised_cosine(sps, sps, 1.0, 0.35, 11 * sps + 1)
    states:
